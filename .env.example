# Resend — formulario de contacto (/acerca). Solo servidor: nunca usar el prefijo NEXT_PUBLIC_.
# Copia este archivo a .env.local y rellena los valores.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Bandeja que recibe los mensajes.
# Con el remitente de pruebas onboarding@resend.dev, Resend solo entrega
# al correo del propietario de la cuenta: usa ese correo en desarrollo.
CONTACT_TO_EMAIL=

# Remitente. onboarding@resend.dev funciona sin verificar dominio.
# Para producción, verifica un dominio propio en Resend y usa una dirección de ese dominio.
CONTACT_FROM_EMAIL=
